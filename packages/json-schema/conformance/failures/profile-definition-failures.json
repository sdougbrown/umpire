                    }
                  },
                  "required": [
                    "kind",
                    "cmd"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "manual"
                    },
                    "desc": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "desc"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "umpire": {
