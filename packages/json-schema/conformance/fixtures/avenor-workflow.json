{
  "fixtureVersion": 1,
  "id": "avenor-workflow",
  "description": "Avenor-shaped workflow fixture: nodes with tagged-union actions, edges, enums, constants, local $defs, and coexisting Umpire validators.",
  "profile": {
    "$schema": "https://spec.umpire.tools/profiles/json-schema/v1/profile.schema.json",
    "profileVersion": 1,
    "valueSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "minItems": 1
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "workflowType": {
          "type": "string",
          "enum": [
            "pipeline",
            "fanout",
            "loop"
          ]
        },
        "version": {
          "type": "integer",
          "const": 1
        },
        "status": {
          "type": "string"
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [
        "nodes",
        "title"
      ],
      "additionalProperties": false,
      "$defs": {
        "node": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "action": {
              "$ref": "#/$defs/action"
            },
            "label": {
              "type": "string"
            },
            "timeout": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "normal",
                "high"
              ]
            }
          },
          "required": [
            "id",
            "action"
          ],
          "additionalProperties": false
        },
        "action": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "manual"
                },
                "instructions": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "instructions"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "run"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "timeout": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "kind",
                "command"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "loop"
                },
                "maxIterations": {
                  "type": "integer",
                  "minimum": 1
                },
                "condition": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "maxIterations",
                "condition"
              ],
              "additionalProperties": false
            }
          ]
        },
        "edge": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "minLength": 1
            },
            "to": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        }
      }
    },
    "umpire": {
      "version": 1,
      "conditions": {
        "allowEdits": {
          "type": "boolean"
        }
      },
      "fields": {
        "nodes": {
          "isEmpty": "array",
          "required": true
        },
        "edges": {
          "isEmpty": "array"
        },
        "title": {
          "isEmpty": "string",
          "required": true
        },
        "workflowType": {
          "isEmpty": "string"
        },
        "version": {
          "isEmpty": "number"
        },
        "status": {
          "isEmpty": "string"
        },
        "maxAttempts": {
          "isEmpty": "number"
        }
      },
      "rules": [
        {
          "type": "requires",
          "field": "edges",
          "when": {
            "op": "present",
            "field": "nodes"
          },
          "reason": "Edges must accompany nodes"
        },
        {
          "type": "enabledWhen",
          "field": "status",
          "when": {
            "op": "cond",
            "condition": "allowEdits"
          },
          "reason": "Status editing is disabled"
        }
      ],
      "validators": {
        "status": {
          "op": "matches",
          "pattern": "^(draft|active|archived)$",
          "error": "Status must be draft, active, or archived"
        }
      }
    }
  },
  "cases": [
    {
      "id": "complete-valid-workflow",
      "description": "A complete Avenor workflow with nodes (various action types), edges, title, workflowType enum, and const version.",
      "values": {
        "nodes": [
          {
            "id": "start",
            "action": {
              "kind": "manual",
              "instructions": "Review input data"
            },
            "priority": "high"
          },
          {
            "id": "process",
            "action": {
              "kind": "run",
              "command": "./process.sh"
            },
            "timeout": 300,
            "priority": "normal"
          },
          {
            "id": "loop-check",
            "action": {
              "kind": "loop",
              "maxIterations": 5,
              "condition": "retryCount < 5"
            },
            "label": "Retry loop"
          }
        ],
        "edges": [
          {
            "from": "start",
            "to": "process"
          },
          {
            "from": "process",
            "to": "loop-check"
          }
        ],
        "title": "Data processing pipeline",
        "workflowType": "pipeline",
        "version": 1,
        "maxAttempts": 3
      },
      "conditions": {
        "allowEdits": true
      },
      "expectedStructure": {
        "valid": true,
        "issues": []
      },
      "expectedAvailability": {
        "nodes": {
          "enabled": true,
          "satisfied": true,
          "fair": true,
          "required": true,
          "reason": null,
          "reasons": []
        },
        "edges": {
          "enabled": true,
          "satisfied": true,
          "fair": true,
          "required": false,
          "reason": null,
          "reasons": []
        },
        "title": {
